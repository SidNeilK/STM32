  82:Core/Src/ArduCAM.c ****           wrSensorReg16_8(0x3818, 0xa8);
  83:Core/Src/ArduCAM.c ****           wrSensorReg16_8(0x3621, 0x10);
  84:Core/Src/ArduCAM.c ****           wrSensorReg16_8(0x3801, 0xb0);
  85:Core/Src/ArduCAM.c ****           wrSensorReg16_8(0x4407, 0x04);
  86:Core/Src/ArduCAM.c ****         }
  87:Core/Src/ArduCAM.c ****         else
