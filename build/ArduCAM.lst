  23:Core/Src/ArduCAM.c **** {
  24:Core/Src/ArduCAM.c ****   sensor_model = model;
  25:Core/Src/ArduCAM.c ****   sensor_addr = (model == OV2640 || model == OV9650 || model == OV9655)
  26:Core/Src/ArduCAM.c ****               ? 0x30U : 0x3CU;
  27:Core/Src/ArduCAM.c **** 
  28:Core/Src/ArduCAM.c **** 	switch (model)
  29:Core/Src/ArduCAM.c ****   {
  30:Core/Src/ArduCAM.c ****     case OV2640:
