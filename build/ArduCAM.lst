  31:Core/Src/ArduCAM.c ****     case OV9650:
  32:Core/Src/ArduCAM.c ****     case OV9655:
  33:Core/Src/ArduCAM.c **** 		{		
  34:Core/Src/ArduCAM.c **** 		  wrSensorReg8_8(0xff, 0x01);
  35:Core/Src/ArduCAM.c ****       wrSensorReg8_8(0x12, 0x80);
  36:Core/Src/ArduCAM.c ****       if(m_fmt == JPEG)
  37:Core/Src/ArduCAM.c ****       {
  38:Core/Src/ArduCAM.c **** 				wrSensorRegs8_8(OV2640_JPEG_INIT);
  39:Core/Src/ArduCAM.c **** 				wrSensorRegs8_8(OV2640_YUV422);
  40:Core/Src/ArduCAM.c **** 				wrSensorRegs8_8(OV2640_JPEG);
  41:Core/Src/ArduCAM.c **** 				wrSensorReg8_8(0xff, 0x01);
  42:Core/Src/ArduCAM.c **** 				wrSensorReg8_8(0x15, 0x00);
  43:Core/Src/ArduCAM.c **** 				wrSensorRegs8_8(OV2640_320x240_JPEG);
  44:Core/Src/ArduCAM.c ****       }
  45:Core/Src/ArduCAM.c ****       else
  46:Core/Src/ArduCAM.c ****       {
  47:Core/Src/ArduCAM.c ****         wrSensorRegs8_8(OV2640_QVGA);
  48:Core/Src/ArduCAM.c ****       }
  49:Core/Src/ArduCAM.c ****       break;
  50:Core/Src/ArduCAM.c **** 		}
  51:Core/Src/ArduCAM.c **** 		case OV5640:
  52:Core/Src/ArduCAM.c **** 		{
  53:Core/Src/ArduCAM.c **** 			if (m_fmt == JPEG)
  54:Core/Src/ArduCAM.c **** 			{
  55:Core/Src/ArduCAM.c **** 				wrSensorReg16_8(0x3103, 0x11);
  56:Core/Src/ArduCAM.c **** 				wrSensorReg16_8(0x3008, 0x82);
  57:Core/Src/ArduCAM.c **** 				wrSensorRegs16_8(OV5640YUV_Sensor_Dvp_Init);	
  58:Core/Src/ArduCAM.c **** 				wrSensorRegs16_8(OV5640_JPEG_QSXGA);
  59:Core/Src/ArduCAM.c **** 				wrSensorRegs16_8(OV5640_QSXGA2QVGA);
  60:Core/Src/ArduCAM.c **** 			  wrSensorReg16_8(0x4407, 0x04);
  61:Core/Src/ArduCAM.c **** 
  62:Core/Src/ArduCAM.c **** 			}
  63:Core/Src/ArduCAM.c **** 			else
  64:Core/Src/ArduCAM.c **** 			{
  65:Core/Src/ArduCAM.c **** 				wrSensorReg16_8(0x3103, 0x11);
  66:Core/Src/ArduCAM.c **** 				wrSensorReg16_8(0x3008, 0x82);
  67:Core/Src/ArduCAM.c **** 				wrSensorRegs16_8(OV5640YUV_Sensor_Dvp_Init);
  68:Core/Src/ArduCAM.c **** 				wrSensorRegs16_8(OV5640_RGB_QVGA);
  69:Core/Src/ArduCAM.c **** 			} 
  70:Core/Src/ArduCAM.c **** 			write_reg(ARDUCHIP_TIM, VSYNC_LEVEL_MASK);   //VSYNC is active HIGH
  71:Core/Src/ArduCAM.c **** 			 break;
  72:Core/Src/ArduCAM.c **** 		}
  73:Core/Src/ArduCAM.c **** 		case OV5642:
  74:Core/Src/ArduCAM.c ****       {
  75:Core/Src/ArduCAM.c ****         wrSensorReg16_8(0x3008, 0x80);
  76:Core/Src/ArduCAM.c ****         wrSensorRegs16_8(OV5642_QVGA_Preview);
  77:Core/Src/ArduCAM.c ****       
  78:Core/Src/ArduCAM.c ****         if (m_fmt == JPEG)
