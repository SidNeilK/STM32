  90:Core/Src/ArduCAM.c ****           wrSensorReg16_8(0x4740, 0x21);
  91:Core/Src/ArduCAM.c ****           wrSensorReg16_8(0x501e, 0x2a);
  92:Core/Src/ArduCAM.c ****           wrSensorReg16_8(0x5002, 0xf8);
