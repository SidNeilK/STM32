 226:Core/Src/spi.c **** void SendBufferAsHex(uint8_t *buffer, uint32_t length)
 227:Core/Src/spi.c **** {
 228:Core/Src/spi.c ****   static const char hexDigits[] = "0123456789ABCDEF";
 229:Core/Src/spi.c ****   uint8_t output[3] = {0U, 0U, ' '};
 230:Core/Src/spi.c ****   uint8_t newline = '\n';
 231:Core/Src/spi.c **** 
 232:Core/Src/spi.c ****   for (uint32_t i = 0U; i < length; i++)
 233:Core/Src/spi.c ****   {
 234:Core/Src/spi.c ****     output[0] = (uint8_t)hexDigits[buffer[i] >> 4];
 235:Core/Src/spi.c ****     output[1] = (uint8_t)hexDigits[buffer[i] & 0x0FU];
 236:Core/Src/spi.c ****     (void)HAL_UART_Transmit(&huart4, output, sizeof(output), HAL_MAX_DELAY);
 237:Core/Src/spi.c ****   }
 238:Core/Src/spi.c ****   (void)HAL_UART_Transmit(&huart4, &newline, 1U, HAL_MAX_DELAY);
 239:Core/Src/spi.c **** }
