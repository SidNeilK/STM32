 171:Core/Src/main.c **** 
 172:Core/Src/main.c ****   SingleCapTransfer();
 173:Core/Src/main.c ****   while (receive_OK == false)
 174:Core/Src/main.c ****   {
 175:Core/Src/main.c ****     HAL_Delay(1U);
 176:Core/Src/main.c ****   }
 177:Core/Src/main.c **** 
 178:Core/Src/main.c ****   jpegEnd = jpeglen;
 179:Core/Src/main.c ****   if (jpegEnd < 4U ||
