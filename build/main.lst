  88:Core/Src/main.c **** static void USB_Send(const char *text)
  89:Core/Src/main.c **** {
  90:Core/Src/main.c ****   static uint8_t txBuffer[APP_TX_DATA_SIZE];
  91:Core/Src/main.c ****   size_t length = strlen(text);
  92:Core/Src/main.c **** 
  93:Core/Src/main.c ****   if (length >= sizeof(txBuffer))
  94:Core/Src/main.c ****   {
  95:Core/Src/main.c ****     length = sizeof(txBuffer) - 1U;
  96:Core/Src/main.c ****   }
  97:Core/Src/main.c ****   memcpy(txBuffer, text, length);
  98:Core/Src/main.c ****   txBuffer[length] = '\0';
  99:Core/Src/main.c **** 
 100:Core/Src/main.c ****   for (uint32_t attempt = 0U; attempt < 10U; attempt++)
 101:Core/Src/main.c ****   {
 102:Core/Src/main.c ****     if (CDC_Transmit_FS(txBuffer, (uint16_t)length) == USBD_OK)
 103:Core/Src/main.c ****     {
 104:Core/Src/main.c ****       return;
 105:Core/Src/main.c ****     }
 106:Core/Src/main.c ****     HAL_Delay(2U);
 107:Core/Src/main.c ****   }
 108:Core/Src/main.c **** }
 109:Core/Src/main.c **** 
 110:Core/Src/main.c **** static uint8_t USB_SendBuffer(const uint8_t *buffer, uint16_t length)
 111:Core/Src/main.c **** {
 112:Core/Src/main.c ****   uint32_t startTick = HAL_GetTick();
 113:Core/Src/main.c ****   USBD_CDC_HandleTypeDef *cdcHandle =
 114:Core/Src/main.c ****     (USBD_CDC_HandleTypeDef *)hUsbDeviceFS.pClassData;
 115:Core/Src/main.c **** 
 116:Core/Src/main.c ****   while (CDC_Transmit_FS((uint8_t *)buffer, length) != USBD_OK)
 117:Core/Src/main.c ****   {
 118:Core/Src/main.c ****     if ((HAL_GetTick() - startTick) >= 1000U)
 119:Core/Src/main.c ****     {
 120:Core/Src/main.c ****       return 0U;
 121:Core/Src/main.c ****     }
 122:Core/Src/main.c ****     HAL_Delay(1U);
 123:Core/Src/main.c ****   }
 124:Core/Src/main.c **** 
 125:Core/Src/main.c ****   while (cdcHandle != NULL && cdcHandle->TxState != 0U)
 126:Core/Src/main.c ****   {
 127:Core/Src/main.c ****     if ((HAL_GetTick() - startTick) >= 2000U)
 128:Core/Src/main.c ****     {
 129:Core/Src/main.c ****       return 0U;
 130:Core/Src/main.c ****     }
 131:Core/Src/main.c ****     HAL_Delay(1U);
 132:Core/Src/main.c ****   }
 133:Core/Src/main.c **** 
 134:Core/Src/main.c ****   return 1U;
