 137:Core/Src/main.c **** static uint8_t USB_SendSnapshotHex(const uint8_t *buffer, uint32_t length)
 138:Core/Src/main.c **** {
 139:Core/Src/main.c ****   static const char hexDigits[] = "0123456789ABCDEF";
 140:Core/Src/main.c ****   uint8_t output[192];
 141:Core/Src/main.c ****   uint32_t index = 0U;
 142:Core/Src/main.c **** 
 143:Core/Src/main.c ****   while (index < length)
 144:Core/Src/main.c ****   {
 145:Core/Src/main.c ****     uint16_t outputLength = 0U;
 146:Core/Src/main.c **** 
 147:Core/Src/main.c ****     while (index < length && outputLength + 2U <= sizeof(output))
 148:Core/Src/main.c ****     {
 149:Core/Src/main.c ****       uint8_t value = buffer[index++];
 150:Core/Src/main.c **** 
 151:Core/Src/main.c ****       output[outputLength++] = (uint8_t)hexDigits[value >> 4];
 152:Core/Src/main.c ****       output[outputLength++] = (uint8_t)hexDigits[value & 0x0FU];
 153:Core/Src/main.c ****     }
 154:Core/Src/main.c **** 
 155:Core/Src/main.c ****     if (USB_SendBuffer(output, outputLength) == 0U)
 156:Core/Src/main.c ****     {
 157:Core/Src/main.c ****       return 0U;
 158:Core/Src/main.c ****     }
 159:Core/Src/main.c ****   }
 160:Core/Src/main.c **** 
 161:Core/Src/main.c ****   return 1U;
 162:Core/Src/main.c **** }
