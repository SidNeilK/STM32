 278:USB_DEVICE/App/usbd_cdc_if.c ****     /* Enter sends a carriage return, newline, or both */
 279:USB_DEVICE/App/usbd_cdc_if.c ****     if (ch == '\r' || ch == '\n')
 280:USB_DEVICE/App/usbd_cdc_if.c ****     {
 281:USB_DEVICE/App/usbd_cdc_if.c ****       lineTerminatorReceived = 1U;
