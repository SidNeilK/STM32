 319:USB_DEVICE/App/usbd_cdc_if.c ****     usbCommand[usbCommandLength] = '\0';
 320:USB_DEVICE/App/usbd_cdc_if.c ****     usbCommandReady = 1U;
 321:USB_DEVICE/App/usbd_cdc_if.c ****     usbCommandLength = 0U;
 322:USB_DEVICE/App/usbd_cdc_if.c ****   }
