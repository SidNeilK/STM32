 293:USB_DEVICE/App/usbd_cdc_if.c ****       {
 294:USB_DEVICE/App/usbd_cdc_if.c ****         usbCommandLength--;
 295:USB_DEVICE/App/usbd_cdc_if.c ****         usbCommand[usbCommandLength] = '\0';
 296:USB_DEVICE/App/usbd_cdc_if.c ****       }
 297:USB_DEVICE/App/usbd_cdc_if.c ****     }
 298:USB_DEVICE/App/usbd_cdc_if.c ****     /* Store printable characters */
 299:USB_DEVICE/App/usbd_cdc_if.c ****     else if (ch >= 32U && ch <= 126U)
 300:USB_DEVICE/App/usbd_cdc_if.c ****     {
 301:USB_DEVICE/App/usbd_cdc_if.c ****       if (usbCommandLength < sizeof(usbCommand) - 1U)
 302:USB_DEVICE/App/usbd_cdc_if.c ****       {
 303:USB_DEVICE/App/usbd_cdc_if.c ****         usbCommand[usbCommandLength++] = (char)ch;
 304:USB_DEVICE/App/usbd_cdc_if.c ****         usbCommand[usbCommandLength] = '\0';
 305:USB_DEVICE/App/usbd_cdc_if.c ****       }
 306:USB_DEVICE/App/usbd_cdc_if.c ****     }
 307:USB_DEVICE/App/usbd_cdc_if.c ****   }
 308:USB_DEVICE/App/usbd_cdc_if.c **** 
 309:USB_DEVICE/App/usbd_cdc_if.c ****   /*
 310:USB_DEVICE/App/usbd_cdc_if.c ****    * Some serial-monitor send buttons transmit the message without CR/LF.
 311:USB_DEVICE/App/usbd_cdc_if.c ****    * Treat that complete USB packet as a command so pressing Enter is not
