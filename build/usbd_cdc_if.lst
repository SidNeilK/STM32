 285:USB_DEVICE/App/usbd_cdc_if.c ****         usbCommandReady = 1U;
 286:USB_DEVICE/App/usbd_cdc_if.c ****         usbCommandLength = 0U;
 287:USB_DEVICE/App/usbd_cdc_if.c ****       }
 288:USB_DEVICE/App/usbd_cdc_if.c ****     }
 289:USB_DEVICE/App/usbd_cdc_if.c ****     /* Handle Backspace */
 290:USB_DEVICE/App/usbd_cdc_if.c ****     else if (ch == '\b' || ch == 0x7FU)
 291:USB_DEVICE/App/usbd_cdc_if.c ****     {
